# Example shapes only — copy to terraform.tfvars and fill in real values.
# Do NOT commit terraform.tfvars (it is gitignored alongside *.tfstate*).

project     = "gameplatform"
environment = "development"
aws_region  = "eu-central-1"

vpc_cidr = "10.0.0.0/16"

cluster_version         = "1.30"
eks_node_instance_types = ["t3.medium"]
db_instance_class       = "db.t4g.micro"
redis_node_type         = "cache.t4g.micro"

# "owner/repo" — scopes the GitHub Actions OIDC trust policy to
# repo:<this>:ref:refs/heads/<github_branch> (see modules/ci-cd).
github_repository = "your-org/your-repo"
github_branch     = "main"

# Git URL of this same repository — Argo CD's root Application tracks
# charts/ here, on this branch.
gitops_repo_url = "https://github.com/your-org/your-repo.git"
gitops_branch   = "main"
